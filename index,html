/* ============ 渲染 ============ */
const main = document.getElementById('main');
const toc  = document.getElementById('toc');

DATA.forEach((ch, ci)=>{
  const sec = document.createElement('section');
  sec.className = 'chapter';
  sec.id = 'ch' + ci;

  const h2 = document.createElement('h2');
  h2.textContent = ch[0];
  sec.appendChild(h2);

  ch[1].forEach(item=>{
    const parts = item.split('|');
    const div = document.createElement('div');
    div.className = 'item';
    const ansTxt = parts[1] ? parts[1] : '—';
    const body   = parts.slice(2).join('|');
    div.innerHTML =
      '<span class="num">' + parts[0] + '.</span>' +
      '<span class="ans">' + ansTxt + '</span>' +
      '<span class="body">' + body + '</span>';
    sec.appendChild(div);
  });

  main.appendChild(sec);

  // 目录
  const a = document.createElement('a');
  a.href = '#ch' + ci;
  a.textContent = ch[0];
  a.dataset.idx = ci;
  toc.appendChild(a);
});

/* ============ 搜索 ============ */
const searchBox = document.getElementById('search');
const clearBtn  = document.getElementById('clearBtn');
const allItems  = () => document.querySelectorAll('.item');

function doSearch(){
  const kw = searchBox.value.trim().toLowerCase();
  const items = allItems();
  if(!kw){
    items.forEach(el=>{ el.classList.remove('hide','hit');
      const b = el.querySelector('.body'); if(b.dataset.orig) b.innerHTML = b.dataset.orig;
    });
    document.querySelectorAll('.chapter').forEach(s=>s.style.display='');
    return;
  }
  // 逐题过滤
  items.forEach(el=>{
    const text = el.textContent.toLowerCase();
    const hit = text.includes(kw);
    el.classList.toggle('hide', !hit);
    el.classList.toggle('hit', hit);
    const b = el.querySelector('.body');
    if(!b.dataset.orig) b.dataset.orig = b.innerHTML;
    if(hit){
      const raw = b.dataset.orig;
      const idx = raw.toLowerCase().indexOf(kw);
      if(idx >= 0){
        b.innerHTML = raw.slice(0,idx) + '<mark>' + raw.slice(idx, idx+kw.length) + '</mark>' + raw.slice(idx+kw.length);
      }else{
        b.innerHTML = raw;
      }
    }else{
      b.innerHTML = b.dataset.orig;
    }
  });
  // 隐藏空章节
  document.querySelectorAll('.chapter').forEach(sec=>{
    const visible = sec.querySelectorAll('.item:not(.hide)').length;
    sec.style.display = visible ? '' : 'none';
  });
}
searchBox.addEventListener('input', doSearch);
clearBtn.addEventListener('click', ()=>{ searchBox.value=''; doSearch(); searchBox.focus(); });

/* ============ 折叠解析 ============ */
const foldBtn = document.getElementById('foldBtn');
let folded = false;
foldBtn.addEventListener('click', ()=>{
  folded = !folded;
  document.querySelectorAll('.item .body').forEach(b=>{ b.style.display = folded ? 'none' : ''; });
  foldBtn.textContent = folded ? '展开解析' : '折叠解析';
});

/* ============ 目录高亮 ============ */
const tocLinks = toc.querySelectorAll('a');
const observer = new IntersectionObserver(entries=>{
  entries.forEach(en=>{
    if(en.isIntersecting){
      const id = en.target.id;
      tocLinks.forEach(a=>a.classList.toggle('active', a.getAttribute('href') === '#'+id));
    }
  });
},{rootMargin:'-130px 0px -70% 0px'});
document.querySelectorAll('.chapter').forEach(s=>observer.observe(s));

/* ============ 回到顶部 ============ */
const topBtn = document.getElementById('top');
window.addEventListener('scroll', ()=>{
  topBtn.classList.toggle('show', window.scrollY > 400);
});
topBtn.addEventListener('click', ()=> window.scrollTo({top:0,behavior:'smooth'}));
</script>
